APP_NAME="LIA Media Archive"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8020

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=lia_media
DB_USERNAME=lia_media
DB_PASSWORD=change-me
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

APP_TIMEZONE=UTC
SESSION_SECURE_COOKIE=false
SESSION_COOKIE=lia_media_session

# Sanctum SPA (same origin). Production: media.loveinarts.com
SANCTUM_STATEFUL_DOMAINS=localhost:8020,127.0.0.1:8020

# Cloudflare R2 (S3-compatible). Placeholders only; real keys are entered on the server, never committed.
MEDIA_DISK=r2
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET=lia-media-archive
R2_ENDPOINT=https://your-cloudflare-account-id.r2.cloudflarestorage.com
R2_REGION=auto
R2_USE_PATH_STYLE=true
# Presigned URL lifetimes (seconds)
MEDIA_UPLOAD_URL_TTL=3600
MEDIA_PREVIEW_URL_TTL=300
MEDIA_DOWNLOAD_URL_TTL=600
# Uploads larger than this use multipart (bytes)
MEDIA_MULTIPART_THRESHOLD=104857600
MEDIA_PART_SIZE=33554432
MEDIA_MAX_FILE_SIZE=21474836480

# Backups: pluggable driver, disabled for now (null). Future: rclone
MEDIA_BACKUP_DRIVER=null
