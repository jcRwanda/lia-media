{
    "$schema": "https://opencode.ai/config.json",
    "mcp": {
        "laravel-boost": {
            "type": "local",
            "enabled": true,
            "command": [
                "php",
                "artisan",
                "boost:mcp"
            ]
        }
    },
    "permission": {
        "external_directory": {
            "/tmp/**": "allow",
            "*": "ask"
        }
    }
}